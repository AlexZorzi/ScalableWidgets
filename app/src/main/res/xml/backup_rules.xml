<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up: tokens are encrypted with device-bound Keystore keys. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
