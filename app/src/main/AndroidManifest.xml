<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Firebase Analytics adds this; the app never uses the advertising ID. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <!-- Lets a widget tap open Scalable's own app. -->
    <queries>
        <package android:name="capital.scalable.droid" />
    </queries>

    <!-- Session secrets are bound to Keystore keys, so backups could never be restored. -->
    <application
        android:name=".ScalableApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScalableCapitalWidgets"
        tools:targetApi="31">
        <!-- Off until the user accepts the introduction; see telemetry/Telemetry.kt. -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_ssaid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ScalableCapitalWidgets"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.WidgetTickReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.ClassicPortfolioReceiver"
            android:exported="true"
            android:label="@string/widget_classic_portfolio_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_classic_portfolio_info" />
        </receiver>

        <receiver
            android:name=".widget.ClassicPositionsReceiver"
            android:exported="true"
            android:label="@string/widget_classic_positions_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_classic_positions_info" />
        </receiver>

        <receiver
            android:name=".widget.MaterialPortfolioReceiver"
            android:exported="true"
            android:label="@string/widget_material_portfolio_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_material_portfolio_info" />
        </receiver>

        <receiver
            android:name=".widget.MaterialPositionsReceiver"
            android:exported="true"
            android:label="@string/widget_material_positions_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_material_positions_info" />
        </receiver>
    </application>

</manifest>
